{
  "cell_centered": true,
  "face_rule": "a_face=f_air*1+(1-f_air)/7.29 from exact Shapely line intersection",
  "forbidden": [
    "harmonic-cell primary",
    "point sampling",
    "smoothing",
    "tuning",
    "MPB/Meep epsilon"
  ],
  "grid": "Nx=3N, Ny=N, dx=dy=1/N",
  "method": {
    "dependencies_existing_only": [
      "numpy",
      "scipy",
      "shapely"
    ],
    "face_coefficient": "exact Shapely line fraction of a=1/epsilon",
    "production_integration": false,
    "type": "exact_face_conservative_scalar_TE_finite_volume"
  }
}
