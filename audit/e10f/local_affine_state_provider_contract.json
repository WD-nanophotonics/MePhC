{
  "schema": "mephc-local-affine-state-provider-contract-v2",
  "boundary": "generic local-affine state provider; model-specific geometry is supplied by an adapter",
  "canonical_identity_fields": [
    "model_id", "reference_cell_id", "public_q", "s", "F_s", "A_s", "derived_kappa",
    "geometry_digest", "resolution", "num_bands", "polarization", "eigensolver_tolerance",
    "mesh_size", "deterministic", "h_representation", "bloch_phase_excluded", "component_basis",
    "mu_contract", "orientation_sign", "fractional_material_indexing_identity",
    "reference_cell_identity", "bloch_phase_convention"
  ],
  "public_input": "physical normalized q; provider computes kappa=A(s)^T q",
  "canonical_reciprocal_path": "snapshot.provenance[mpb_k_point]",
  "optional_caller_detail_reciprocal_path": "snapshot.provenance[caller_provenance][mpb_reciprocal_k_point]",
  "reference_cell_compatibility_contract": {
    "representation": "mpb_periodic_h_l2_v1",
    "bloch_phase_excluded": true,
    "component_order": "supplied final axis order",
    "component_basis": "LAB_CARTESIAN",
    "mu_contract": "MU1_NONMAGNETIC",
    "orientation_sign": 1,
    "fractional_material_indexing_identity": "SAME_FRACTIONAL_IX_IY_MATERIAL_COORDINATES",
    "reference_cell_identity": "must equal reference_cell_id"
  },
  "solver_configuration": {
    "resolution": 64,
    "num_bands": 6,
    "polarization": "opaque runtime object forwarded unchanged",
    "polarization_identity": "explicit semantic string; for the frozen TM program: TM",
    "eigensolver_tolerance": 1e-7,
    "mesh_size": 3,
    "deterministic": true,
    "phase_callback": null
  },
  "polarization_identity_contract": {
    "solver_polarization_handle": "opaque runtime object",
    "canonical_polarization_identity": "explicit semantic string",
    "state_identity_polarization": "must equal canonical identity",
    "implicit_runtime_object_string_inference_forbidden": true,
    "missing_handle_or_semantic_identity": "fails closed before underlying provider construction",
    "returned_provenance": "local_affine_solver_polarization_identity",
    "underlying_solver_polarization_provenance": "preserved unchanged"
  },
  "acquisition_pre_persistence_verification": {
    "identity": "local_affine_state_identity",
    "identity_digest": "local_affine_state_identity_sha256",
    "reference_cell_contract": "local_affine_reference_cell_contract",
    "reciprocal_metadata": "canonical top-level mpb_k_point",
    "guard_location": "before store.put"
  },
  "live_certification": "pending; this contract work order performs no live provider request or solver execution",
  "no_reduction": true,
  "no_cache": true,
  "no_retry": true
}
